# Use this file together with the non-secret deployment state file documented in
# apps/server/docs/postgresql-production-migration.md.
COMPOSE_PROJECT_NAME=docmost
DOCMOST_IMAGE=shererpro/docmost:VERSION@sha256:REPLACE_WITH_IMAGE_DIGEST
APP_URL=https://docs.example.com
COLLAB_URL=https://collab.example.com
TRUSTED_PROXIES=10.0.0.0/8
EDGE_NETWORK_NAME=edge
DOCMOST_BIND_ADDRESS=127.0.0.1
DRAWIO_URL=https://embed.diagrams.net
DOCMOST_MAINTENANCE_ENTER_HOOK=/usr/local/sbin/docmost-maintenance-enter
DOCMOST_MAINTENANCE_EXIT_HOOK=/usr/local/sbin/docmost-maintenance-exit
# Нужен при переходе со старой topology, чей image нельзя запустить новым Compose.
# Хук восстанавливает сохранённый legacy Compose и прежний ingress, затем сам проверяет health.
DOCMOST_ROLLBACK_HOOK=

APP_SECRET=REPLACE_WITH_LONG_SECRET
COLLAB_INTERNAL_SECRET=REPLACE_WITH_ANOTHER_LONG_SECRET
POSTGRES_DB=docmost
POSTGRES_USER=docmost
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD
DATABASE_URL=postgresql://docmost:REPLACE_WITH_STRONG_DATABASE_PASSWORD@db:5432/docmost
REDIS_URL=redis://redis:6379

AUTH_RATE_LIMIT_STORAGE=redis
STORAGE_DRIVER=local
PERFORMANCE_DIAGNOSTICS_ENABLED=false
