{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "rag-sync",
  "projectType": "application",
  "sourceRoot": "apps/rag-sync/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "apps/rag-sync",
        "command": "corepack pnpm run build"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": "apps/rag-sync",
        "command": "node --test \"dist/**/*.spec.js\""
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": "apps/rag-sync",
        "command": "node dist/main.js"
      }
    }
  }
}
