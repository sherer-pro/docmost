# Keep obsolete standalone-sync files local while operators remove them.
rag-sync.config.json
/.rag-sync
**/DOCMOST_RAG_KEY
**/OPEN_WEBUI_KEY
secrets/
# Persistent, operator-owned installation records and imported private history.
# This is not a scratch/report directory. Preserve it before removing a checkout.
/operator-data/
data
# Local audit, e2e and scratch artifacts. These runs produce gigabytes of
# Playwright reports, traces and downloads. Curated evidence that must live in
# the repository is added deliberately with `git add -f`.
/output/
/tmp/

# Local AI-generated audit and release-readiness narratives.
/docs/audit/
/docs/*-audit-*.md
/docs/release-readiness-*.md
# compiled output
/dist
/node_modules
# Build output of the retired standalone rag-sync worker.
/apps/rag-sync/dist/
/apps/rag-sync/node_modules/

