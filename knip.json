{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "package.json"],
      "project": ["*.cjs", "*.json", "scripts/*.mjs"],
      "ignoreBinaries": ["cmd.exe"],
      "ignoreDependencies": ["@nx/js", "concurrently", "jscpd"]
    },
    "apps/server": {
      "entry": [
        "src/main.ts",
        "src/app.module.ts",
        "src/collaboration/server/collab-main.ts",
        "src/database/migrate-latest.ts",
        "src/database/preflight.ts",
        "src/database/migrations/*.ts",
        "src/**/*.spec.ts",
        "src/**/*.spec.tsx"
      ],
      "project": ["src/**/*.ts", "src/**/*.tsx"],
      "ignoreDependencies": ["pino-pretty"]
    },
    "apps/client": {
      "entry": [
        "src/main.tsx",
        "src/**/*.test.ts",
        "src/**/*.test.tsx",
        "e2e/**/*.mjs"
      ],
      "project": ["src/**/*.ts", "src/**/*.tsx", "e2e/**/*.mjs"]
    },
    "packages/api-contract": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/editor-ext": {
      "entry": ["src/index.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts", "src/**/*.tsx"],
      "ignoreDependencies": ["@types/turndown"]
    }
  },
  "ignore": [
    "**/dist/**",
    "**/coverage/**",
    "**/.nx/**",
    ".claude/**",
    "output/**",
    "tmp/**",
    "apps/server/docs/api-route-inventory.generated.md"
  ]
}
