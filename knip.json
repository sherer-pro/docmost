{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "package.json"],
      "project": ["*.cjs", "*.json", "scripts/*.mjs"]
    },
    "apps/server": {
      "entry": [
        "src/main.ts",
        "src/app.module.ts",
        "src/collaboration/server/collab-main.ts",
        "src/database/migrations/*.ts",
        "src/**/*.spec.ts",
        "src/**/*.spec.tsx"
      ],
      "project": ["src/**/*.ts", "src/**/*.tsx"],
      "ignoreDependencies": ["pino-pretty"]
    },
    "apps/client": {
      "entry": ["src/main.tsx", "src/**/*.test.ts", "src/**/*.test.tsx"],
      "project": ["src/**/*.ts", "src/**/*.tsx"]
    },
    "packages/api-contract": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/editor-ext": {
      "entry": ["src/index.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts", "src/**/*.tsx"]
    }
  },
  "ignore": [
    "**/dist/**",
    "**/coverage/**",
    "**/.nx/**",
    "apps/server/docs/api-route-inventory.generated.md"
  ]
}
