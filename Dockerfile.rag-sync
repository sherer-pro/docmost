FROM node:22-slim AS base

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@10.4.0 --activate

FROM base AS builder

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml nx.json .npmrc ./
COPY apps/rag-sync/package.json ./apps/rag-sync/package.json
COPY packages/api-contract/package.json ./packages/api-contract/package.json

RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --filter @docmost/rag-sync...

COPY packages/api-contract ./packages/api-contract
COPY apps/rag-sync ./apps/rag-sync

RUN pnpm --filter @docmost/api-contract build && \
    pnpm --filter @docmost/rag-sync build

FROM node:22-slim AS runner

ENV NODE_ENV=production
WORKDIR /app

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/rag-sync/node_modules ./apps/rag-sync/node_modules
COPY --from=builder /app/apps/rag-sync/package.json ./apps/rag-sync/package.json
COPY --from=builder /app/apps/rag-sync/dist ./apps/rag-sync/dist
COPY --from=builder /app/packages/api-contract/package.json ./packages/api-contract/package.json
COPY --from=builder /app/packages/api-contract/dist ./packages/api-contract/dist

USER node

CMD ["node", "apps/rag-sync/dist/main.js"]
