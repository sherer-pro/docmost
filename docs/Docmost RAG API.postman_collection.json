{
  "info": {
    "_postman_id": "37163490-6653-4c21-8984-d48b99762f6e",
    "name": "Docmost RAG API",
    "description": "Postman collection for testing Docmost RAG API and space-scoped API keys. Paginated feeds use opaque cursor v2: retain the starting watermark while following nextCursor and advance it only when hasMore=false. Legacy v1 and cross-feed/scope/watermark cursors are rejected. See docs/RAG_API.md for the full contract.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "1347003"
  },
  "item": [
    {
      "name": "01 - API Keys Management (owner/admin session required)",
      "item": [
        {
          "name": "List RAG API Keys (workspace owner/admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const payload = pm.response.json();",
                  "const items = payload?.data?.items || [];",
                  "if (items.length > 0) {",
                  "  const first = items[0];",
                  "  if (first.id) pm.collectionVariables.set('createdApiKeyId', first.id);",
                  "  if (first.spaceId) pm.collectionVariables.set('spaceId', first.spaceId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"limit\": 20,\n  \"keyType\": \"rag\",\n  \"query\": \"\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api-keys",
              "host": ["{{baseUrl}}"],
              "path": ["api-keys"]
            },
            "description": "List workspace RAG keys. The endpoint always requires owner/admin; adminView is retired."
          },
          "response": []
        },
        {
          "name": "Create API Key (No expiration)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const payload = pm.response.json();",
                  "const data = payload?.data || payload;",
                  "if (data?.id) pm.collectionVariables.set('createdApiKeyId', data.id);",
                  "if (data?.token) {",
                  "  pm.collectionVariables.set('createdApiKeyToken', data.token);",
                  "  pm.collectionVariables.set('ragApiKey', data.token);",
                  "}",
                  "if (data?.spaceId) pm.collectionVariables.set('spaceId', data.spaceId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{apiKeyName}}\",\n  \"spaceId\": \"{{spaceId}}\",\n  \"keyType\": \"rag\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api-keys/create",
              "host": ["{{baseUrl}}"],
              "path": ["api-keys", "create"]
            },
            "description": "Creates a space-scoped API key and stores token into collection variable ragApiKey."
          },
          "response": []
        },
        {
          "name": "Update API Key Name",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"apiKeyId\": \"{{createdApiKeyId}}\",\n  \"name\": \"{{apiKeyName}} (renamed)\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api-keys/update",
              "host": ["{{baseUrl}}"],
              "path": ["api-keys", "update"]
            },
            "description": "Rename an existing API key."
          },
          "response": []
        },
        {
          "name": "Revoke API Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"apiKeyId\": \"{{createdApiKeyId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api-keys/revoke",
              "host": ["{{baseUrl}}"],
              "path": ["api-keys", "revoke"]
            },
            "description": "Soft-delete (revoke) API key."
          },
          "response": []
        }
      ],
      "description": "These endpoints use regular authenticated session/JWT and return envelope response { data, success, status }."
    },
    {
      "name": "02 - RAG API (Bearer API key required)",
      "item": [
        {
          "name": "GET /rag/scope",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ragApiKey}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/rag/scope",
              "host": ["{{baseUrl}}"],
              "path": ["rag", "scope"]
            },
            "description": "Returns the workspace and space resolved from the RAG key, the non-secret Open WebUI sync target configured in space AI settings, and the effective AI/RAG exclusion fingerprint and excluded backing page ids."
          },
          "response": []
        },
        {
