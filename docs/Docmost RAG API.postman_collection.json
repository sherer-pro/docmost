              "raw": "{{baseUrl}}/rag/scope/blocked?limit={{limit}}",
              "host": ["{{baseUrl}}"],
              "path": ["rag", "scope", "blocked"],
              "query": [
                {
                  "key": "limit",
                  "value": "{{limit}}"
                },
                {
                  "key": "cursor",
                  "value": "{{cursor}}",
                  "disabled": true
                }
              ]
            },
            "description": "Opaque feed of backing page IDs that left the effective synchronization scope."
          },
          "response": []
        },
        {
          "name": "GET /rag/pages",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "const items = Array.isArray(res?.items) ? res.items : [];",
                  "const firstDoc = items.find((x) => x?.id);",
                  "if (firstDoc) {",
                  "  pm.collectionVariables.set('pageIdOrSlug', firstDoc.slugId || firstDoc.id);",
                  "}",
                  "const firstDb = items.find((x) => x?.type === 'database');",
                  "if (firstDb) {",
                  "  pm.collectionVariables.set('databaseIdOrPageSlug', firstDb.databaseId || firstDb.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ragApiKey}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/rag/pages?includeContent={{includeContent}}&limit={{limit}}",
              "host": ["{{baseUrl}}"],
              "path": ["rag", "pages"],
              "query": [
                {
                  "key": "includeContent",
                  "value": "{{includeContent}}"
                },
                {
                  "key": "limit",
                  "value": "{{limit}}"
                },
                {
                  "key": "cursor",
                  "value": "{{cursor}}",
                  "disabled": true
                }
              ]
            },
            "description": "Full list of active page|database in the scoped space."
          },
          "response": []
        },
